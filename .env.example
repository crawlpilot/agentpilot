# Role for this process: monolith (default, non-Docker/local/test only --
# no longer a docker-compose deployment target) | gateway | worker.
BAAS_ROLE=monolith

# Session-registry / proxy-pinning backend. Stays Redis -- ephemeral
# distributed-lock/routing state, not user data, unaffected by the move to
# Postgres below. Required for BAAS_ROLE=gateway (no fallback); worker/
# monolith degrade gracefully to in-memory/disabled if left unset. Not a
# docker-compose service -- run it yourself (e.g. `brew install redis &&
# brew services start redis`) and reach it from containers via
# host.docker.internal instead of localhost.
BAAS_REDIS_URL=redis://localhost:6379/0

# API-key/auth persistence (Postgres, moved off Redis -- this is the actual
# "user management" data: tenant, key hash, name, revocation). Unset ->
# falls back to an in-memory store (dev/test convenience, not for real
# deployment, not shared across processes). Run `alembic upgrade head`
# against this URL before starting the app. Also not a docker-compose
# service, same as Redis above -- use host.docker.internal from containers.
BAAS_DATABASE_URL=postgresql://baas:baas@localhost:5432/baas

# Gates /v1/api-keys (issuing/revoking tenant API keys). Unset -> that
# surface 401s unconditionally (fails closed), not "auth disabled".
BAAS_ADMIN_TOKEN=

# Only used by BAAS_ROLE=gateway, to reach its worker.
BAAS_WORKER_URL=http://worker:8000

# Only used by BAAS_ROLE=worker/monolith.
BAAS_VAULT_KEY=
BAAS_PROXY_POOL=
