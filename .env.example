# Role for this process: monolith (default, non-Docker/local/test only --
# no longer a docker-compose deployment target) | gateway | worker.
AGENTPILOT_ROLE=monolith

# Session-registry / proxy-pinning backend. Stays Redis -- ephemeral
# distributed-lock/routing state, not user data, unaffected by the move to
# Postgres below. Required for AGENTPILOT_ROLE=gateway (no fallback); worker/
# monolith degrade gracefully to in-memory/disabled if left unset. Not a
# docker-compose service -- run it yourself (e.g. `brew install redis &&
# brew services start redis`) and reach it from containers via
# host.docker.internal instead of localhost.
AGENTPILOT_REDIS_URL=redis://localhost:6379/0

# API-key/auth persistence (Postgres, moved off Redis -- this is the actual
# "user management" data: tenant, key hash, name, revocation). Unset ->
# falls back to an in-memory store (dev/test convenience, not for real
# deployment, not shared across processes). Run `alembic upgrade head`
# against this URL before starting the app. Also not a docker-compose
# service, same as Redis above -- use host.docker.internal from containers.
AGENTPILOT_DATABASE_URL=postgresql://agentpilot:agentpilot@localhost:5432/agentpilot

# Gates /v1/api-keys (issuing/revoking tenant API keys). Unset -> that
# surface 401s unconditionally (fails closed), not "auth disabled".
AGENTPILOT_ADMIN_TOKEN=

# Only used by AGENTPILOT_ROLE=gateway, to reach its worker.
AGENTPILOT_WORKER_URL=http://worker:8000

# Only used by AGENTPILOT_ROLE=worker/monolith.
AGENTPILOT_VAULT_KEY=
AGENTPILOT_PROXY_POOL=

# Gates `ScrapeOptions.extract` (schema/prompt-driven LLM structured
# extraction, `agentpilot.llm`). Unset -> that feature fails closed with a
# descriptive `Document.extract_error` per request, not a silent no-op --
# every other format (markdown/text/html/structured_data) is unaffected.
# OpenAI-compatible `/chat/completions` API -- works against OpenAI, Azure
# OpenAI, OpenRouter, or a local vLLM/Ollama-compatible server by pointing
# AGENTPILOT_LLM_BASE_URL at it, no code changes.
AGENTPILOT_LLM_API_KEY=
AGENTPILOT_LLM_BASE_URL=https://api.openai.com/v1
AGENTPILOT_LLM_MODEL=gpt-4o-mini
AGENTPILOT_LLM_TIMEOUT_S=60

# Tunables for the web-agent platform (/v1/agent/runs, agentpilot.agent +
# agentpilot.jobs.agent_worker_loop). Reuses AGENTPILOT_LLM_* above for the
# agent's own step-by-step LLM calls -- no separate API key needed.
# AGENTPILOT_AGENT_MAX_FAILURES: consecutive step failures (observe/LLM/
# dispatch errors) before a run gives up rather than retrying forever.
# AGENTPILOT_AGENT_STEP_TIMEOUT_S: unset (default) means no per-step
# timeout; set it to bound how long one step's browser/LLM call may hang
# before being treated as a failed step.
AGENTPILOT_AGENT_MAX_FAILURES=5
AGENTPILOT_AGENT_STEP_TIMEOUT_S=
